{
  "name": "cert-checker",
  "version": "1.0.0",
  "description": "轻量证书/域名到期监控脚本：HTTPS 证书 + 域名注册到期检测，支持邮箱/飞书/企微/钉钉通知",
  "type": "module",
  "main": "check.js",
  "scripts": {
    "start": "node check.js",
    "watch": "node check.js --watch 3600",
    "test:notify": "node check.js --test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "nodemailer": "^6.9.16"
  }
}
